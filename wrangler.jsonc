{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-browser",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/ProjectJangu/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
